# Copy to .env for local dev. In production, inject via Coolify's env var UI.
# The sim is fully in-memory - no database required.

# Comma-separated CORS allowlist. Production (set in Coolify UI) is the four
# frontend origins documented in README.md → Production runtime & build.
ALLOWED_ORIGINS=https://matrixmole.com,https://www.matrixmole.com,https://staging.matrixmole.com,http://localhost:3000

# Site session capacity and lifecycle
MAX_CONCURRENT_PAIRS=50
SESSION_IDLE_TIMEOUT_SECONDS=300
SESSION_MAX_LIFETIME_SECONDS=600
